datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OwnerRole {
  owner
  super_admin @map("super-admin")
}

enum OwnerStatus {
  Pending
  Active
  Blocked
}

enum BoutiqueStatus {
  Active
  Inactive
}

enum PayoutStatus {
  Pending
  Verified
  Rejected
}

enum SubscriptionPlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum DesignCategory {
  Blouse
  Lehenga
  Saree
  Other
}

enum OrderStatus {
  pending
  accepted
  in_progress
  ready
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  captured
  failed
  refunded
}

enum PayoutStatusType {
  pending
  scheduled
  completed
  failed
}

enum ActivityType {
  order
  user
  success
}

enum RecipientRole {
  super_admin @map("super-admin")
  owner
}

enum NotificationType {
  ORDER_NEW
  ORDER_STATUS
  SYSTEM
  BROADCAST
}

enum CustomerNotificationType {
  ORDER_PLACED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ORDER_SHIPPED
  ORDER_DELIVERED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  EXCHANGE_REQUESTED
  EXCHANGE_APPROVED
  EXCHANGE_SHIPPED
  REVIEW_REPLY
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  PROMOTION
}

enum RecipientType {
  SUPER_ADMIN
  OWNER
  EMPLOYEE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AdminNotificationType {
  NEW_ORDER
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  ORDER_CANCELLED
  ORDER_RETURN_REQUEST
  ORDER_RETURN_APPROVED
  ORDER_RETURN_REJECTED
  ORDER_EXCHANGE_REQUEST
  ORDER_EXCHANGE_APPROVED
  NEW_BOOKING
  BOOKING_CANCELLED
  NEW_MEASUREMENT
  NEW_REVIEW
  LOW_STOCK
  OUT_OF_STOCK
  PRODUCT_APPROVAL
  EMPLOYEE_ASSIGNED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  SYSTEM_ALERT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum BookingStatus {
  Pending
  Accepted
  Rejected
  Rescheduled
  Completed
}

enum BookingType {
  HOME_MEASUREMENT
  STORE_VISIT
  VIDEO_CONSULTATION
  DESIGN_DISCUSSION
  TRIAL_FITTING
  FINAL_DELIVERY
}

enum TicketType {
  REFUND_REQUEST
  ORDER_ISSUE
  PAYMENT_ISSUE
  CUSTOMER_COMPLAINT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketEscalationLevel {
  NONE
  L1
  L2
  L3
}

enum TicketSource {
  MOBILE
  WEB
  EMAIL
  CHAT
}

enum PayoutState {
  PENDING
  APPROVED
  RELEASED
  FAILED
}

enum CustomerSegment {
  NEW
  ACTIVE
  VIP
  INACTIVE
  BLOCKED
}

model User {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone                 String                 @unique @db.VarChar(20)
  name                  String?                @default("New User") @db.VarChar(255)
  status                UserStatus             @default(ACTIVE)
  segment               CustomerSegment        @default(NEW)
  otp                   String?                @db.VarChar(6)
  otpExpiresAt          DateTime?              @map("otp_expires_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  payments              Payment[]
  measurement           Measurement?
  reviews               Review[]
  wishlists             Wishlist[]
  productWishlists      ProductWishlist[]
  supportTickets        SupportTicket[]
  addresses             CustomerAddress[]
  notifications         Notification[]
  cart                  Cart?
  shippingAddresses     ShippingAddress[]
  commerceOrders        CommerceOrder[]
  productReviews        ProductReview[]
  couponUsages          CouponUsage[]
  returnRequests        ReturnRequest[]
  exchangeRequests      ExchangeRequest[]
  customerNotifications CustomerNotification[]

  @@map("users")
}

model Boutique {
  id                          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                        String         @db.VarChar(255)
  ownerName                   String         @map("owner_name") @db.VarChar(255)
  description                 String?        @default("") @db.Text
  experienceYears             Int            @default(0) @map("experience_years")
  status                      BoutiqueStatus @default(Active)
  featuredBoutique            Boolean        @default(false) @map("featured_boutique")
  verified                    Boolean        @default(false)
  ownerId                     String?        @map("owner_id") @db.Uuid
  happyClients                Int            @default(0) @map("happy_clients")
  totalDesigns                Int            @default(0) @map("total_designs")
  mobileNumber                String         @map("mobile_number") @db.VarChar(20)
  whatsappNumber              String?        @default("") @map("whatsapp_number") @db.VarChar(20)
  email                       String         @db.VarChar(255)
  fullAddress                 String         @map("full_address") @db.Text
  area                        String?        @default("") @db.VarChar(100)
  city                        String         @db.VarChar(100)
  state                       String         @db.VarChar(100)
  pincode                     String?        @default("") @db.VarChar(20)
  googleMapsLink              String?        @default("") @map("google_maps_link") @db.VarChar(512)
  serviceRadius               String?        @default("") @map("service_radius") @db.VarChar(100)
  openDays                    String?        @default("") @map("open_days") @db.VarChar(255)
  openingTime                 String?        @default("") @map("opening_time") @db.VarChar(20)
  closingTime                 String?        @default("") @map("closing_time") @db.VarChar(20)
  weeklyHoliday               String?        @default("") @map("weekly_holiday") @db.VarChar(50)
  servicesOffered             String[]       @default([]) @map("services_offered")
  workTypeSpecialty           String[]       @default([]) @map("work_type_specialty")
  pickupAvailable             Boolean        @default(false) @map("pickup_available")
  deliveryAvailable           Boolean        @default(false) @map("delivery_available")
  homeVisitAvailable          Boolean        @default(false) @map("home_visit_available")
  appointmentBookingAvailable Boolean        @default(false) @map("appointment_booking_available")
  rushOrderAvailable          Boolean        @default(false) @map("rush_order_available")
  startingPrice               Decimal        @default(0.00) @map("starting_price") @db.Decimal(12, 2)
  turnaroundTime              String?        @default("") @map("turnaround_time") @db.VarChar(100)
  logoUrl                     String?        @default("") @map("logo_url") @db.VarChar(512)
  coverImageUrl               String?        @default("") @map("cover_image_url") @db.VarChar(512)
  galleryUrls                 String[]       @default([]) @map("gallery_urls")
  instagramHandle             String?        @default("") @map("instagram_handle") @db.VarChar(100)
  facebookPage                String?        @default("") @map("facebook_page") @db.VarChar(255)
  websiteLink                 String?        @default("") @map("website_link") @db.VarChar(512)
  verificationDocuments       String[]       @default([]) @map("verification_documents")
  payoutDetails               String?        @default("") @map("payout_details") @db.Text
  payoutStatus                PayoutStatus   @default(Pending) @map("payout_status")
  internalNotes               String?        @default("") @map("internal_notes") @db.Text
  isDeleted                   Boolean        @default(false) @map("is_deleted")
  deletedAt                   DateTime?      @map("deleted_at")
  rating                      Decimal        @default(0.00) @db.Decimal(3, 2)
  reviewsCount                Int            @default(0) @map("reviews_count")
  version                     Int            @default(0)
  createdAt                   DateTime       @default(now()) @map("created_at")

  commissionRate  Decimal @default(10.00) @map("commission_rate") @db.Decimal(5, 2)
  responseTimeAvg Int     @default(0) @map("response_time_avg")

  // Boutique Wallet Fields
  walletBalance Decimal @default(0.00) @map("wallet_balance") @db.Decimal(12, 2)
  pendingPayout Decimal @default(0.00) @map("pending_payout") @db.Decimal(12, 2)
  totalPaidOut  Decimal @default(0.00) @map("total_paid_out") @db.Decimal(12, 2)

  // Emergency & Subscription Enforcement Controls
  isFrozen                Boolean @default(false) @map("is_frozen")
  isSuspended             Boolean @default(false) @map("is_suspended")
  subscriptionEnforcement Boolean @default(true) @map("subscription_enforcement")

  owners             Owner[]                @relation("BoutiqueOwners")
  primaryOwner       Owner?                 @relation("BoutiquePrimaryOwner", fields: [ownerId], references: [id])
  designs            Design[]
  orders             Order[]
  bookings           Booking[]
  notifications      Notification[]
  payments           Payment[]
  reviews            Review[]
  supportTickets     SupportTicket[]
  payouts            Payout[]
  subscriptions      BoutiqueSubscription[]
  customPlanRequests CustomPlanRequest[]
  products           Product[]
  productBrands      ProductBrand[]
  productTags        ProductTag[]
  commerceOrders     CommerceOrder[]
  coupons            Coupon[]

  @@index([isDeleted, status, featuredBoutique, createdAt])
  @@index([ownerId])
  @@index([city])
  @@map("boutiques")
}

model Owner {
  id                  String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerName           String      @map("owner_name") @db.VarChar(255)
  username            String      @unique @db.VarChar(100)
  email               String      @unique @db.VarChar(255)
  mobileNumber        String      @map("mobile_number") @db.VarChar(20)
  password            String      @db.VarChar(255)
  role                OwnerRole   @default(owner)
  status              OwnerStatus @default(Pending)
  assignedBoutiqueId  String?     @map("assigned_boutique_id") @db.Uuid
  inviteTokenHash     String?     @map("invite_token_hash") @db.VarChar(64)
  inviteExpiresAt     DateTime?   @map("invite_expires_at")
  resetPasswordToken  String?     @map("reset_password_token") @db.VarChar(64)
  resetPasswordExpire DateTime?   @map("reset_password_expire")
  mustResetPassword   Boolean     @default(true) @map("must_reset_password")
  emailVerified       Boolean     @default(false) @map("email_verified")
  lastLogin           DateTime?   @map("last_login")
  isDeleted           Boolean     @default(false) @map("is_deleted")
  createdAt           DateTime    @default(now()) @map("created_at")

  // Emergency Control Flags
  loginEnabled Boolean @default(true) @map("login_enabled")
  readOnlyMode Boolean @default(false) @map("read_only_mode")

  // Flattened Permissions
  canEditProfile    Boolean @default(true) @map("can_edit_profile")
  canEditServices   Boolean @default(true) @map("can_edit_services")
  canEditGallery    Boolean @default(true) @map("can_edit_gallery")
  canManageDesigns  Boolean @default(true) @map("can_manage_designs")
  canManageOrders   Boolean @default(true) @map("can_manage_orders")
  canManageBookings Boolean @default(true) @map("can_manage_bookings")
  canManageReviews  Boolean @default(true) @map("can_manage_reviews")
  canManageMedia    Boolean @default(true) @map("can_manage_media")
  canViewAnalytics  Boolean @default(true) @map("can_view_analytics")

  // Owner Override Permissions (separate from Subscription Features)
  canManageCustomers    Boolean @default(true) @map("can_manage_customers")
  canManageMeasurements Boolean @default(true) @map("can_manage_measurements")
  canManageInventory    Boolean @default(true) @map("can_manage_inventory")
  canManageExpenses     Boolean @default(true) @map("can_manage_expenses")
  canManageProduction   Boolean @default(true) @map("can_manage_production")
  canManageDelivery     Boolean @default(true) @map("can_manage_delivery")
  canManageMarketing    Boolean @default(true) @map("can_manage_marketing")
  canManageRoles        Boolean @default(true) @map("can_manage_roles")
  canManageBranches     Boolean @default(true) @map("can_manage_branches")
  canExportReports      Boolean @default(true) @map("can_export_reports")

  boutique           Boutique?                @relation("BoutiqueOwners", fields: [assignedBoutiqueId], references: [id])
  primaryBoutiques   Boutique[]               @relation("BoutiquePrimaryOwner")
  orders             Order[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  assignedBookings   Booking[]
  supportTickets     SupportTicket[]
  ticketAdminNotes   SupportTicketAdminNote[]
  featurePermission  OwnerFeaturePermission?
  customPlanRequests CustomPlanRequest[]

  @@index([assignedBoutiqueId])
  @@index([status])
  @@map("owners")
}

model Design {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boutiqueId  String         @map("boutique_id") @db.Uuid
  name        String         @db.VarChar(255)
  description String?        @db.Text
  category    DesignCategory
  images      String[]       @default([])
  price       Decimal        @default(0.00) @db.Decimal(12, 2)
  tags        String[]       @default([])
  isFeatured  Boolean        @default(false) @map("is_featured")
  isAvailable Boolean        @default(true) @map("is_available")
  isReadyMade Boolean        @default(false) @map("is_ready_made")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  createdAt   DateTime       @default(now()) @map("created_at")

  boutique  Boutique   @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  orders    Order[]
  wishlists Wishlist[]

  @@index([boutiqueId, isDeleted])
  @@map("designs")
}

model Order {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId         String         @unique @map("order_id") @db.VarChar(50)
  boutiqueId      String         @map("boutique_id") @db.Uuid
  ownerId         String         @map("owner_id") @db.Uuid
  customerName    String         @map("customer_name") @db.VarChar(255)
  customerPhone   String         @map("customer_phone") @db.VarChar(20)
  customerAddress String?        @map("customer_address") @db.Text
  designId        String?        @map("design_id") @db.Uuid
  designName      String?        @map("design_name") @db.VarChar(255)
  category        DesignCategory @default(Blouse)

  // Measurements
  measurementBust         Decimal? @map("measurement_bust") @db.Decimal(5, 2)
  measurementWaist        Decimal? @map("measurement_waist") @db.Decimal(5, 2)
  measurementHip          Decimal? @map("measurement_hip") @db.Decimal(5, 2)
  measurementShoulder     Decimal? @map("measurement_shoulder") @db.Decimal(5, 2)
  measurementSleeveLength Decimal? @map("measurement_sleeve_length") @db.Decimal(5, 2)
  measurementBlouseLength Decimal? @map("measurement_blouse_length") @db.Decimal(5, 2)
  measurementNotes        String?  @map("measurement_notes") @db.Text

  // Pricing
  price           Decimal @default(0.00) @db.Decimal(12, 2)
  advancePaid     Decimal @default(0.00) @map("advance_paid") @db.Decimal(12, 2)
  remainingAmount Decimal @default(0.00) @map("remaining_amount") @db.Decimal(12, 2)

  orderStatus          OrderStatus   @default(pending) @map("order_status")
  paymentStatus        PaymentStatus @default(pending) @map("payment_status")
  orderDate            DateTime      @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?     @map("expected_delivery_date")
  actualDeliveryDate   DateTime?     @map("actual_delivery_date")
  isDeleted            Boolean       @default(false) @map("is_deleted")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  boutique       Boutique        @relation(fields: [boutiqueId], references: [id])
  owner          Owner           @relation(fields: [ownerId], references: [id])
  design         Design?         @relation(fields: [designId], references: [id])
  orderHistories OrderHistory[]
  payments       Payment[]
  reviews        Review[]
  supportTickets SupportTicket[]
  bookings       Booking[]       @relation("OrderBookings")

  @@index([boutiqueId, isDeleted, createdAt])
  @@index([ownerId])
  @@index([designId])
  @@index([customerPhone, isDeleted])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderHistory {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String   @db.VarChar(50)
  note      String?  @db.Text
  timestamp DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, timestamp])
  @@map("order_histories")
}

model Booking {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boutiqueId      String        @map("boutique_id") @db.Uuid
  bookingType     BookingType   @default(STORE_VISIT) @map("booking_type")
  customerName    String        @map("customer_name") @db.VarChar(255)
  customerEmail   String?       @map("customer_email") @db.VarChar(255)
  customerMobile  String        @map("customer_mobile") @db.VarChar(20)
  bookingDate     DateTime      @map("booking_date") @db.Date
  bookingTime     String        @map("booking_time") @db.VarChar(20)
  notes           String?       @db.Text
  status          BookingStatus @default(Pending)
  assignedOwnerId String?       @map("assigned_owner_id") @db.Uuid
  reminderSent    Boolean       @default(false) @map("reminder_sent")
  orderId         String?       @map("order_id") @db.Uuid
  isDeleted       Boolean       @default(false) @map("is_deleted")
  createdAt       DateTime      @default(now()) @map("created_at")

  boutique         Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  assignedOwner    Owner?           @relation(fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  bookingHistories BookingHistory[]
  order            Order?           @relation("OrderBookings", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([boutiqueId, status, bookingType])
  @@index([assignedOwnerId])
  @@index([customerMobile])
  @@index([bookingDate])
  @@index([orderId])
  @@map("bookings")
}

model Measurement {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  chest        Decimal? @db.Decimal(5, 2)
  waist        Decimal? @db.Decimal(5, 2)
  length       Decimal? @db.Decimal(5, 2)
  shoulder     Decimal? @db.Decimal(5, 2)
  sleeveLength Decimal? @map("sleeve_length") @db.Decimal(5, 2)
  neck         Decimal? @db.Decimal(5, 2)
  notes        String?  @db.Text
  updatedAt    DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model Notification {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recipientRole   RecipientRole    @map("recipient_role")
  recipientId     String?          @map("recipient_id") @db.Uuid
  recipientUserId String?          @map("recipient_user_id") @db.Uuid
  boutiqueId      String?          @map("boutique_id") @db.Uuid
  title           String           @db.VarChar(255)
  message         String           @db.Text
  type            NotificationType @default(SYSTEM)
  status          String           @default("sent") @db.VarChar(50)
  isRead          Boolean          @default(false) @map("is_read")
  scheduledAt     DateTime?        @map("scheduled_at")
  isBroadcast     Boolean          @default(false) @map("is_broadcast")
  createdAt       DateTime         @map("created_at")

  targetType  String? @map("target_type") @db.VarChar(50)
  targetValue String? @map("target_value") @db.VarChar(100)

  sentPush  Boolean @default(false) @map("sent_push")
  sentEmail Boolean @default(false) @map("sent_email")
  sentSms   Boolean @default(false) @map("sent_sms")

  campaignId String? @map("campaign_id") @db.Uuid

  recipient     Owner?                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientUser User?                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  boutique      Boutique?             @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  campaign      NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  receipts      NotificationReceipt[]

  @@index([recipientRole, recipientId, isRead])
  @@index([recipientUserId])
  @@index([boutiqueId])
  @@index([campaignId])
  @@index([createdAt])
  @@map("notifications")
}

model Payment {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId             String           @map("order_id") @db.Uuid
  boutiqueId          String           @map("boutique_id") @db.Uuid
  customerId          String?          @map("customer_id") @db.Uuid
  amount              Decimal          @db.Decimal(12, 2)
  currency            String?          @default("INR") @db.VarChar(10)
  status              PaymentStatus    @default(pending)
  method              String?          @db.VarChar(50)
  commissionAmount    Decimal          @default(0.00) @map("commission_amount") @db.Decimal(12, 2)
  netAmount           Decimal          @default(0.00) @map("net_amount") @db.Decimal(12, 2)
  payoutStatus        PayoutStatusType @default(pending) @map("payout_status")
  payoutId            String?          @map("payout_id") @db.Uuid
  refundId            String?          @map("refund_id") @db.VarChar(100)
  refundReason        String?          @map("refund_reason") @db.Text
  razorpay_order_id   String?          @db.VarChar(100)
  razorpay_payment_id String?          @db.VarChar(100)
  razorpay_signature  String?          @db.VarChar(255)
  receipt             String?          @db.VarChar(100)
  description         String?          @db.Text
  metadata            Json?
  createdAt           DateTime         @default(now()) @map("created_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  customer User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payout   Payout?  @relation("PayoutPayments", fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([boutiqueId])
  @@index([customerId])
  @@index([payoutId])
  @@index([status])
  @@index([payoutStatus])
  @@map("payments")
}

model Activity {
  id        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type      ActivityType
  title     String       @db.VarChar(255)
  price     String?      @db.VarChar(100)
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("activities")
}

model AuditLog {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actionType    String   @map("action_type") @db.VarChar(100)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String   @map("entity_id") @db.VarChar(50)
  performedBy   String   @map("performed_by") @db.Uuid
  changesBefore Json?    @map("changes_before")
  changesAfter  Json?    @map("changes_after")
  metadata      Json?
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  timestamp     DateTime @default(now())

  owner Owner @relation(fields: [performedBy], references: [id])

  @@index([performedBy])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model CustomerAddress {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  addressLine1 String   @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  pincode      String   @db.VarChar(20)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("customer_addresses")
}

model Payout {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boutiqueId    String      @map("boutique_id") @db.Uuid
  amount        Decimal     @db.Decimal(12, 2)
  status        PayoutState @default(PENDING)
  payoutId      String?     @map("payout_id") @db.VarChar(100)
  referenceCode String?     @map("reference_code") @db.VarChar(100)
  payoutDate    DateTime?   @map("payout_date")
  errorMsg      String?     @map("error_msg") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  boutique Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  payments Payment[] @relation("PayoutPayments")

  @@index([boutiqueId, status])
  @@map("payouts")
}

model Review {
  id                  String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boutiqueId          String                 @map("boutique_id") @db.Uuid
  userId              String                 @map("user_id") @db.Uuid
  orderId             String?                @map("order_id") @db.Uuid
  rating              Int
  ratingStitching     Int?                   @map("rating_stitching")
  ratingMeasurement   Int?                   @map("rating_measurement")
  ratingDelivery      Int?                   @map("rating_delivery")
  ratingCommunication Int?                   @map("rating_communication")
  ratingValue         Int?                   @map("rating_value")
  comment             String?                @db.Text
  reply               String?                @db.Text
  verifiedPurchase    Boolean                @default(false) @map("verified_purchase")
  reviewImages        String[]               @default([]) @map("review_images")
  reportCount         Int                    @default(0) @map("report_count")
  moderationStatus    ReviewModerationStatus @default(PENDING) @map("moderation_status")
  isSuspicious        Boolean                @default(false) @map("is_suspicious")
  suspiciousReason    String?                @map("suspicious_reason") @db.Text
  ipAddress           String?                @map("ip_address") @db.VarChar(45)
  createdAt           DateTime               @default(now()) @map("created_at")

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([boutiqueId, moderationStatus, createdAt])
  @@index([userId])
  @@index([orderId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  designId  String   @map("design_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId], map: "uq_user_design")
  @@map("wishlists")
}

model BookingHistory {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  status    String   @db.VarChar(50)
  note      String?  @db.Text
  timestamp DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, timestamp])
  @@map("booking_histories")
}

model SupportTicket {
  id              String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  boutiqueId      String?               @map("boutique_id") @db.Uuid
  orderId         String?               @map("order_id") @db.Uuid
  ticketType      TicketType            @map("ticket_type")
  priority        TicketPriority        @default(MEDIUM)
  escalationLevel TicketEscalationLevel @default(NONE) @map("escalation_level")
  source          TicketSource          @default(WEB)
  subject         String                @db.VarChar(255)
  description     String                @db.Text
  status          TicketStatus          @default(OPEN)
  assignedAdminId String?               @map("assigned_admin_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  // SLA Tracking
  firstResponseAt DateTime? @map("first_response_at")
  resolvedAt      DateTime? @map("resolved_at")
  escalatedAt     DateTime? @map("escalated_at")
  slaBreached     Boolean   @default(false) @map("sla_breached")

  // Fraud & Risk Indicators
  fraudScore          Int     @default(0) @map("fraud_score")
  riskLevel           String  @default("LOW") @map("risk_level") // 'LOW', 'MEDIUM', 'HIGH'
  excessiveTicketFlag Boolean @default(false) @map("excessive_ticket_flag")

  // Attachments
  attachmentUrl  String? @map("attachment_url") @db.VarChar(512)
  attachmentType String? @map("attachment_type") @db.VarChar(50)

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  boutique      Boutique?                @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedAdmin Owner?                   @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      SupportTicketMessage[]
  adminNotes    SupportTicketAdminNote[]

  @@index([userId])
  @@index([boutiqueId, status])
  @@index([orderId])
  @@index([assignedAdminId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  senderType     String   @map("sender_type") @db.VarChar(50) // 'CUSTOMER', 'BOUTIQUE', 'ADMIN'
  senderId       String   @map("sender_id") @db.Uuid
  senderName     String   @map("sender_name") @db.VarChar(255)
  message        String   @db.Text
  attachmentUrl  String?  @map("attachment_url") @db.VarChar(512)
  attachmentType String?  @map("attachment_type") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model SupportTicketAdminNote {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  note      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  Owner         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("support_ticket_admin_notes")
}

model NotificationTemplate {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String   @unique @db.VarChar(100) // e.g. 'BOOKING_APPROVED', 'ORDER_DELIVERED'
  subject   String   @db.VarChar(255)
  body      String   @db.Text
  channels  String[] @default([]) // e.g. ['push', 'email', 'sms']
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model NotificationCampaign {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String         @db.VarChar(255)
  title         String         @db.VarChar(255)
  message       String         @db.Text
  targetType    String         @map("target_type") @db.VarChar(50)
  targetValue   String?        @map("target_value") @db.VarChar(100)
  channels      String[]       @default([])
  scheduledAt   DateTime?      @map("scheduled_at")
  status        String         @default("draft") @db.VarChar(50)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  notifications Notification[]

  @@map("notification_campaigns")
}

model PlatformSetting {
  id                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  globalCommissionRate Decimal  @default(10.00) @map("global_commission_rate") @db.Decimal(5, 2)
  categoryCommissions  Json     @default("{}") @map("category_commissions")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model SubscriptionPlan {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String   @db.VarChar(100) // E.g., 'Starter', 'Gold Premium'
  planCode        String   @unique @map("plan_code") @db.VarChar(100) // E.g., 'starter_monthly', 'gold_annual'
  description     String?  @default("") @db.Text
  monthlyPrice    Decimal  @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice     Decimal  @map("yearly_price") @db.Decimal(12, 2)
  trialPeriodDays Int      @default(14) @map("trial_period_days")
  gracePeriodDays Int      @default(3) @map("grace_period_days")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  isFeatured      Boolean  @default(false) @map("is_featured")
  recommendedPlan Boolean  @default(false) @map("recommended_plan")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Business Model Control
  allowDirectSelling   Boolean @default(true) @map("allow_direct_selling")
  allowCustomTailoring Boolean @default(false) @map("allow_custom_tailoring")

  // Subscription Plan Limit Controls (-1 represents Unlimited)
  maxReadyMadeProducts Int @default(-1) @map("max_ready_made_products")
  maxCustomDesigns     Int @default(50) @map("max_custom_designs")
  maxOrdersPerMonth    Int @default(100) @map("max_orders_per_month")
  maxBookingsPerMonth  Int @default(50) @map("max_bookings_per_month")
  maxCustomers         Int @default(-1) @map("max_customers")
  maxMeasurements      Int @default(-1) @map("max_measurements")
  maxGalleryImages     Int @default(20) @map("max_gallery_images")
  maxStaffAccounts     Int @default(5) @map("max_staff_accounts")
  maxBranches          Int @default(1) @map("max_branches")

  // Product Commerce Features (Direct Selling)
  canManageProducts        Boolean @default(false) @map("can_manage_products")
  canManageStock           Boolean @default(false) @map("can_manage_stock")
  canManageShipping        Boolean @default(false) @map("can_manage_shipping")
  canManageReturns         Boolean @default(false) @map("can_manage_returns")
  canManageCoupons         Boolean @default(false) @map("can_manage_coupons")
  canManageOffers          Boolean @default(false) @map("can_manage_offers")
  canManageProductVariants Boolean @default(false) @map("can_manage_product_variants")
  canManageReviews         Boolean @default(true) @map("can_manage_reviews")

  // Custom Tailoring Features
  canUseCustomMeasurements    Boolean @default(true) @map("can_use_custom_measurements")
  canUseMeasurementHistory    Boolean @default(false) @map("can_use_measurement_history")
  canCreateCustomOrders       Boolean @default(true) @map("can_create_custom_orders")
  canManageTailoringOrders    Boolean @default(true) @map("can_manage_tailoring_orders")
  canManageProductionWorkflow Boolean @default(false) @map("can_manage_production_workflow")
  canManageTailorAssignments  Boolean @default(false) @map("can_manage_tailor_assignments")

  // Customer Features
  canManageCustomers     Boolean @default(true) @map("can_manage_customers")
  canManageCustomerNotes Boolean @default(true) @map("can_manage_customer_notes")
  canManageRewards       Boolean @default(false) @map("can_manage_rewards")
  canManageReferrals     Boolean @default(false) @map("can_manage_referrals")
  canManageWallet        Boolean @default(false) @map("can_manage_wallet")

  // Staff Features
  canManageStaff      Boolean @default(true) @map("can_manage_staff")
  canManageAttendance Boolean @default(false) @map("can_manage_attendance")
  canManageTasks      Boolean @default(false) @map("can_manage_tasks")
  canManagePayroll    Boolean @default(false) @map("can_manage_payroll")

  // Marketing Features
  canUseWhatsAppMarketing Boolean @default(false) @map("can_use_whatsapp_marketing")
  canUseSmsMarketing      Boolean @default(false) @map("can_use_sms_marketing")
  canUseEmailMarketing    Boolean @default(false) @map("can_use_email_marketing")
  canCreateCampaigns      Boolean @default(false) @map("can_create_campaigns")

  // Analytics Features
  canViewAnalytics         Boolean @default(false) @map("can_view_analytics")
  canViewAdvancedAnalytics Boolean @default(false) @map("can_view_advanced_analytics")
  canViewFinancialReports  Boolean @default(false) @map("can_view_financial_reports")

  // Marketplace Features
  canListInMarketplace  Boolean @default(true) @map("can_list_in_marketplace")
  canFeatureProducts    Boolean @default(false) @map("can_feature_products")
  canFeatureBoutique    Boolean @default(false) @map("can_feature_boutique")
  canSellPremiumDesigns Boolean @default(false) @map("can_sell_premium_designs")

  // AI Features
  canUseAiAssistant         Boolean @default(false) @map("can_use_ai_assistant")
  canUseAiRecommendations   Boolean @default(false) @map("can_use_ai_recommendations")
  canUseAiDesignSuggestions Boolean @default(false) @map("can_use_ai_design_suggestions")

  // Enterprise Features
  canUseApiAccess      Boolean @default(false) @map("can_use_api_access")
  canUseCustomBranding Boolean @default(false) @map("can_use_custom_branding")
  canUseWhiteLabel     Boolean @default(false) @map("can_use_white_label")
  canUseMultiBranch    Boolean @default(false) @map("can_use_multi_branch")

  subscriptions BoutiqueSubscription[]

  @@map("subscription_plans")
}

model BoutiqueSubscription {
  id          String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boutiqueId  String             @map("boutique_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus @default(TRIAL)
  startDate   DateTime           @map("start_date")
  endDate     DateTime           @map("end_date")
  trialEndsAt DateTime?          @map("trial_ends_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Subscription Usage Tracking
  currentReadyMadeProductsCount Int @default(0) @map("current_ready_made_products_count")
  currentCustomDesignsCount     Int @default(0) @map("current_custom_designs_count")
  currentOrderCount             Int @default(0) @map("current_order_count")
  currentBookingCount           Int @default(0) @map("current_booking_count")
  currentCustomerCount          Int @default(0) @map("current_customer_count")
  currentMeasurementsCount      Int @default(0) @map("current_measurements_count")
  currentGalleryImages          Int @default(0) @map("current_gallery_images")
  currentStaffAccounts          Int @default(0) @map("current_staff_accounts")
  currentBranchCount            Int @default(0) @map("current_branch_count")

  // Trial conversion tracking metrics
  trialStartedAt DateTime? @map("trial_started_at")
  trialEndedAt   DateTime? @map("trial_ended_at")
  convertedAt    DateTime? @map("converted_at")

  // Future payment gateway configuration fields
  gatewayCustomerId     String? @map("gateway_customer_id") @db.VarChar(100)
  gatewaySubscriptionId String? @map("gateway_subscription_id") @db.VarChar(100)
  gatewayPaymentId      String? @map("gateway_payment_id") @db.VarChar(100)
  pendingPlanId         String? @map("pending_plan_id") @db.Uuid

  boutique       Boutique                     @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingHistory SubscriptionBillingHistory[]

  @@index([boutiqueId])
  @@map("boutique_subscriptions")
}

model SubscriptionBillingHistory {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  paymentStatus  String   @map("payment_status") @db.VarChar(50)
  paymentMethod  String?  @map("payment_method") @db.VarChar(50)
  invoiceUrl     String?  @map("invoice_url") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at")

  subscription BoutiqueSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_billing_history")
}

model Category {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.VarChar(512)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subCategories SubCategory[]
  products      Product[]

  @@map("categories")
}

model SubCategory {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.VarChar(512)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, name])
  @@map("sub_categories")
}

model NotificationReceipt {
  id               String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  notificationId   String  @map("notification_id") @db.Uuid
  recipientOwnerId String? @map("recipient_owner_id") @db.Uuid
  recipientUserId  String? @map("recipient_user_id") @db.Uuid

  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  openedAt    DateTime? @map("opened_at")
  clickedAt   DateTime? @map("clicked_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_receipts")
}

model OwnerFeaturePermission {
  id                     String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId                String  @unique @map("owner_id") @db.Uuid
  canManageOrders        Boolean @default(true) @map("can_manage_orders")
  canManageBookings      Boolean @default(true) @map("can_manage_bookings")
  canManageReviews       Boolean @default(true) @map("can_manage_reviews")
  canManagePayments      Boolean @default(true) @map("can_manage_payments")
  canManagePayouts       Boolean @default(true) @map("can_manage_payouts")
  canManageGallery       Boolean @default(true) @map("can_manage_gallery")
  canManageDesigns       Boolean @default(true) @map("can_manage_designs")
  canManageAnalytics     Boolean @default(true) @map("can_manage_analytics")
  canManageNotifications Boolean @default(true) @map("can_manage_notifications")
  canManageStaff         Boolean @default(true) @map("can_manage_staff")

  // Product Commerce Features
  canManageProducts Boolean @default(true) @map("can_manage_products")

  // Owner Override Permissions (separate from Subscription Features)
  canManageCustomers    Boolean @default(true) @map("can_manage_customers")
  canManageMeasurements Boolean @default(true) @map("can_manage_measurements")
  canManageInventory    Boolean @default(true) @map("can_manage_inventory")
  canManageExpenses     Boolean @default(true) @map("can_manage_expenses")
  canManageProduction   Boolean @default(true) @map("can_manage_production")
  canManageDelivery     Boolean @default(true) @map("can_manage_delivery")
  canManageMarketing    Boolean @default(true) @map("can_manage_marketing")
  canManageRoles        Boolean @default(true) @map("can_manage_roles")
  canManageBranches     Boolean @default(true) @map("can_manage_branches")
  canExportReports      Boolean @default(true) @map("can_export_reports")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("owner_feature_permissions")
}

model CustomPlanRequest {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boutiqueId       String   @map("boutique_id") @db.Uuid
  ownerId          String   @map("owner_id") @db.Uuid
  requestedDesigns Int      @map("requested_designs")
  requestedOrders  Int      @map("requested_orders")
  requestedGallery Int      @map("requested_gallery")
  requestedStaff   Int      @map("requested_staff")
  reason           String   @db.Text
  status           String   @default("PENDING") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("custom_plan_requests")
}

// ─────────────────────────────────────────────
// Product Management (Direct Selling / Ready-Made)
// ─────────────────────────────────────────────

enum ProductType {
  READY_MADE
  PRE_ORDER
  CUSTOM
  DIGITAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryType {
  STANDARD
  EXPRESS
  PICKUP
  HOME_DELIVERY
  SHIP
}

model ProductBrand {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  logo        String?  @db.VarChar(512)
  boutiqueId  String   @map("boutique_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  boutique Boutique  @relation(fields: [boutiqueId], references: [id])
  products Product[]

  @@unique([boutiqueId, name])
  @@map("product_brands")
}

model ProductTag {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String   @db.VarChar(100)
  boutiqueId String   @map("boutique_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  boutique Boutique  @relation(fields: [boutiqueId], references: [id])
  products Product[]

  @@unique([boutiqueId, name])
  @@map("product_tags")
}

model Product {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boutiqueId    String  @map("boutique_id") @db.Uuid
  brandId       String? @map("brand_id") @db.Uuid
  categoryId    String? @map("category_id") @db.Uuid
  subCategoryId String? @map("sub_category_id") @db.Uuid

  // Classification
  productType ProductType @default(READY_MADE) @map("product_type")

  // Identity
  name             String  @db.VarChar(255)
  description      String? @db.Text
  shortDescription String? @map("short_description") @db.VarChar(500)
  sku              String? @db.VarChar(100)
  barcode          String? @db.VarChar(100)

  // Pricing
  basePrice      Decimal  @map("base_price") @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal? @map("cost_price") @db.Decimal(12, 2)

  // Delivery
  deliveryType DeliveryType @default(STANDARD) @map("delivery_type")
  weight       Decimal?     @db.Decimal(8, 2)
  length       Decimal?     @db.Decimal(8, 2)
  width        Decimal?     @db.Decimal(8, 2)
  height       Decimal?     @db.Decimal(8, 2)

  // Status & Visibility
  status               ProductStatus @default(DRAFT)
  isFeatured           Boolean       @default(false) @map("is_featured")
  isMarketplaceVisible Boolean       @default(true) @map("is_marketplace_visible")
  isTaxable            Boolean       @default(true) @map("is_taxable")
  isDeleted            Boolean       @default(false) @map("is_deleted")

  // Ratings
  averageRating Float @default(0) @map("average_rating")
  reviewCount   Int   @default(0) @map("review_count")

  // SEO
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.Text
  seoSlug        String? @map("seo_slug") @db.VarChar(255)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  boutique           Boutique                  @relation(fields: [boutiqueId], references: [id])
  brand              ProductBrand?             @relation(fields: [brandId], references: [id])
  category           Category?                 @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory?              @relation(fields: [subCategoryId], references: [id])
  images             ProductImage[]
  variants           ProductVariant[]
  variantAttributes  ProductVariantAttribute[]
  tags               ProductTag[]
  analytics          ProductAnalytics[]
  inventoryLogs      ProductInventoryLog[]
  wishlists          ProductWishlist[]
  cartItems          CartItem[]
  commerceOrderItems CommerceOrderItem[]
  productReviews     ProductReview[]

  @@unique([boutiqueId, sku])
  @@index([boutiqueId, status])
  @@index([categoryId])
  @@index([status, createdAt, isMarketplaceVisible])
  @@index([brandId])
  @@index([subCategoryId])
  @@index([seoSlug])
  @@index([boutiqueId, isDeleted, status, createdAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String  @db.VarChar(512)
  alt       String? @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariantAttribute {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String @db.VarChar(100)
  values    Json

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variant_attributes")
}

model ProductVariant {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  sku            String?       @db.VarChar(100)
  name           String        @db.VarChar(255)
  attributes     Json?
  price          Decimal?      @map("price") @db.Decimal(12, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  status         VariantStatus @default(ACTIVE)
  sortOrder      Int           @default(0) @map("sort_order")

  product            Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory          ProductInventory?
  inventoryLogs      ProductInventoryLog[] @relation("InventoryLogVariant")
  cartItems          CartItem[]
  commerceOrderItems CommerceOrderItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([productId, status])
  @@map("product_variants")
}

model ProductInventory {
  id                String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  variantId         String  @unique @map("variant_id") @db.Uuid
  quantity          Int     @default(0)
  reservedQuantity  Int     @default(0) @map("reserved_quantity")
  lowStockThreshold Int     @default(5) @map("low_stock_threshold")
  trackInventory    Boolean @default(true) @map("track_inventory")
  version           Int     @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("product_inventory")
}

model ProductInventoryLog {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  change         Int
  quantityBefore Int      @map("quantity_before")
  quantityAfter  Int      @map("quantity_after")
  reason         String   @db.VarChar(100)
  reference      String?  @db.VarChar(255)
  createdBy      String?  @map("created_by") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation("InventoryLogVariant", fields: [variantId], references: [id])

  @@index([productId, createdAt])
  @@index([variantId])
  @@map("product_inventory_logs")
}

model ProductAnalytics {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  views          Int      @default(0)
  uniqueViews    Int      @default(0) @map("unique_views")
  addToCartCount Int      @default(0) @map("add_to_cart_count")
  orderCount     Int      @default(0) @map("order_count")
  revenue        Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, periodStart, periodEnd])
  @@index([productId])
  @@map("product_analytics")
}

model ProductWishlist {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_wishlists")
}

// ─────────────────────────────────────────────
// Commerce / Direct Selling Models
// ─────────────────────────────────────────────

model Cart {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model ShippingAddress {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(255)
  phone        String   @db.VarChar(20)
  addressLine1 String   @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  pincode      String   @db.VarChar(20)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders CommerceOrder[]

  @@index([userId])
  @@map("shipping_addresses")
}

enum CommerceOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum CommercePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model CommerceOrder {
  id                String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId           String  @unique @map("order_id") @db.VarChar(50)
  userId            String  @map("user_id") @db.Uuid
  boutiqueId        String  @map("boutique_id") @db.Uuid
  shippingAddressId String? @map("shipping_address_id") @db.Uuid

  // Pricing
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingAmount Decimal @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  // Commission & Payout
  commissionAmount Decimal  @default(0) @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal? @map("net_amount") @db.Decimal(12, 2)

  // Coupon
  couponId String? @map("coupon_id") @db.Uuid

  // Payment
  currency       String   @default("INR") @db.VarChar(10)
  paymentMethod  String?  @map("payment_method") @db.VarChar(50)
  paymentDetails Json?    @map("payment_details")
  refundAmount   Decimal? @map("refund_amount") @db.Decimal(12, 2)

  // Status
  status        CommerceOrderStatus   @default(PENDING)
  paymentStatus CommercePaymentStatus @default(PENDING) @map("payment_status")

  // Notes
  customerNote       String? @map("customer_note") @db.Text
  adminNote          String? @map("admin_note") @db.Text
  cancellationReason String? @map("cancellation_reason") @db.Text

  // Timestamps
  paidAt               DateTime? @map("paid_at")
  packedAt             DateTime? @map("packed_at")
  shippedAt            DateTime? @map("shipped_at")
  outForDeliveryAt     DateTime? @map("out_for_delivery_at")
  deliveredAt          DateTime? @map("delivered_at")
  cancelledAt          DateTime? @map("cancelled_at")
  refundedAt           DateTime? @map("refunded_at")
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  user             User                   @relation(fields: [userId], references: [id])
  boutique         Boutique               @relation(fields: [boutiqueId], references: [id])
  shippingAddress  ShippingAddress?       @relation(fields: [shippingAddressId], references: [id])
  items            CommerceOrderItem[]
  coupon           Coupon?                @relation(fields: [couponId], references: [id])
  deliveries       DeliveryTracking[]
  reviews          ProductReview[]
  couponUsages     CouponUsage[]
  payments         CommercePayment[]
  histories        CommerceOrderHistory[]
  returnRequests   ReturnRequest[]
  exchangeRequests ExchangeRequest[]

  @@index([userId, status])
  @@index([boutiqueId, status])
  @@index([orderId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([boutiqueId, createdAt])
  @@index([userId, createdAt])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  productName    String   @map("product_name") @db.VarChar(255)
  variantName    String?  @map("variant_name") @db.VarChar(255)
  sku            String?  @db.VarChar(100)
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice     Decimal  @map("total_price") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  taxRate        Decimal? @map("tax_rate") @db.Decimal(5, 2)
  imageUrl       String?  @map("image_url") @db.VarChar(512)
  attributes     Json?

  order            CommerceOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  variant          ProductVariant?   @relation(fields: [variantId], references: [id])
  returnRequests   ReturnRequest[]
  exchangeRequests ExchangeRequest[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("commerce_order_items")
}

model CommerceOrderHistory {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  fromStatus  String?  @map("from_status") @db.VarChar(50)
  toStatus    String   @map("to_status") @db.VarChar(50)
  note        String?  @db.Text
  changedBy   String?  @map("changed_by") @db.VarChar(50)
  changedById String?  @map("changed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("commerce_order_histories")
}

model Coupon {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code           String    @db.VarChar(50)
  boutiqueId     String?   @map("boutique_id") @db.Uuid
  description    String?   @db.Text
  discountType   String    @map("discount_type") @db.VarChar(20) // PERCENTAGE, FIXED
  discountValue  Decimal   @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount Decimal?  @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?  @map("max_discount") @db.Decimal(12, 2)
  maxUses        Int?      @default(0) @map("max_uses")
  currentUses    Int       @default(0) @map("current_uses")
  maxUsesPerUser Int?      @default(1) @map("max_uses_per_user")
  applicableType String    @default("ALL") @map("applicable_type") @db.VarChar(20) // ALL, PRODUCTS, CATEGORIES
  applicableIds  String[]  @default([]) @map("applicable_ids")
  firstOrderOnly Boolean   @default(false) @map("first_order_only")
  isActive       Boolean   @default(true) @map("is_active")
  startsAt       DateTime? @map("starts_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  boutique Boutique?       @relation(fields: [boutiqueId], references: [id])
  orders   CommerceOrder[]
  usages   CouponUsage[]

  @@unique([code, boutiqueId])
  @@index([code])
  @@index([boutiqueId])
  @@index([isActive, expiresAt, startsAt])
  @@map("coupons")
}

model ProductReview {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  orderId            String?  @map("order_id") @db.Uuid
  rating             Int
  title              String?  @db.VarChar(255)
  comment            String?  @db.Text
  images             String[] @default([])
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  status             String   @default("APPROVED") // PENDING, APPROVED, REJECTED, HIDDEN
  reply              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product Product        @relation(fields: [productId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  order   CommerceOrder? @relation(fields: [orderId], references: [id])

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
  @@map("product_reviews")
}

model DeliveryTracking {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  carrier           String?   @db.VarChar(100)
  trackingNumber    String?   @map("tracking_number") @db.VarChar(255)
  trackingUrl       String?   @map("tracking_url") @db.VarChar(512)
  status            String    @default("PENDING")
  location          String?   @db.VarChar(255)
  note              String?   @db.Text
  estimatedDelivery DateTime? @map("estimated_delivery")
  deliveredAt       DateTime? @map("delivered_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  order     CommerceOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  histories DeliveryTrackingHistory[]

  @@index([orderId])
  @@map("delivery_tracking")
}

model DeliveryTrackingHistory {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  trackingId String   @map("tracking_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(50)
  toStatus   String   @map("to_status") @db.VarChar(50)
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  tracking DeliveryTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)

  @@index([trackingId, createdAt])
  @@map("delivery_tracking_history")
}

model CommercePayment {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  commerceOrderId   String   @map("commerce_order_id") @db.Uuid
  amount            Decimal  @db.Decimal(12, 2)
  method            String?  @db.VarChar(50)
  status            String   @default("PENDING") @db.VarChar(50)
  razorpayOrderId   String?  @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?  @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature String?  @map("razorpay_signature") @db.VarChar(255)
  refundId          String?  @map("refund_id") @db.VarChar(100)
  refundAmount      Decimal? @map("refund_amount") @db.Decimal(12, 2)
  refundReason      String?  @map("refund_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  order CommerceOrder @relation(fields: [commerceOrderId], references: [id], onDelete: Cascade)

  @@index([commerceOrderId])
  @@map("commerce_payments")
}

model CouponUsage {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User          @relation(fields: [userId], references: [id])
  coupon Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@map("coupon_usages")
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
  COMPLETED
}

enum ExchangeStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  SHIPPED
  COMPLETED
}

model ReturnRequest {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  returnNumber String       @unique @map("return_number") @db.VarChar(50)
  orderId      String       @map("order_id") @db.Uuid
  orderItemId  String       @map("order_item_id") @db.Uuid
  customerId   String       @map("customer_id") @db.Uuid
  reason       String       @db.VarChar(255)
  notes        String?      @db.Text
  status       ReturnStatus @default(REQUESTED)
  refundAmount Decimal?     @map("refund_amount") @db.Decimal(12, 2)
  requestedAt  DateTime     @default(now()) @map("requested_at")
  approvedAt   DateTime?    @map("approved_at")
  rejectedAt   DateTime?    @map("rejected_at")
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  order     CommerceOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem CommerceOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customer  User              @relation(fields: [customerId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("return_requests")
}

model ExchangeRequest {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  exchangeNumber String         @unique @map("exchange_number") @db.VarChar(50)
  orderId        String         @map("order_id") @db.Uuid
  orderItemId    String         @map("order_item_id") @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  reason         String         @db.VarChar(255)
  notes          String?        @db.Text
  status         ExchangeStatus @default(REQUESTED)
  requestedAt    DateTime       @default(now()) @map("requested_at")
  approvedAt     DateTime?      @map("approved_at")
  completedAt    DateTime?      @map("completed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  order     CommerceOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem CommerceOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customer  User              @relation(fields: [customerId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("exchange_requests")
}

model OrderSequence {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  date       String   @unique @db.VarChar(10)
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("order_sequences")
}

model CustomerNotification {
  id         String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId String                   @map("customer_id") @db.Uuid
  type       CustomerNotificationType
  title      String                   @db.VarChar(255)
  message    String                   @db.Text
  entityType String?                  @map("entity_type") @db.VarChar(50)
  entityId   String?                  @map("entity_id") @db.VarChar(100)
  isRead     Boolean                  @default(false) @map("is_read")
  metadata   Json?
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isRead])
  @@index([customerId, createdAt])
  @@map("customer_notifications")
}

model AdminNotification {
  id            String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recipientType RecipientType         @map("recipient_type")
  recipientId   String                @map("recipient_id") @db.Uuid
  boutiqueId    String?               @map("boutique_id") @db.Uuid
  type          AdminNotificationType
  priority      NotificationPriority  @default(NORMAL)
  title         String                @db.VarChar(255)
  message       String                @db.Text
  entityType    String?               @map("entity_type") @db.VarChar(50)
  entityId      String?               @map("entity_id") @db.VarChar(100)
  isRead        Boolean               @default(false) @map("is_read")
  metadata      Json?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([recipientType])
  @@index([recipientId])
  @@index([boutiqueId])
  @@index([isRead])
  @@index([createdAt])
  @@map("admin_notifications")
}
