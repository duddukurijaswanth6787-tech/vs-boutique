enum ValidationReportStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
}

enum ValidationReportSectionType {
  FOLDER
  COMPONENTS
  APIS
  CMS_COMPATIBILITY
  PERFORMANCE
  SEO
  ACCESSIBILITY
  SECURITY
  RESPONSIVE
  AI_RECOMMENDATIONS
  SUMMARY
  OVERALL_SCORE
}

enum ExportFormat {
  JSON
  CSV
  PDF
  EXCEL
  MARKDOWN
}

model CmsValidationReport {
  id                    String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  businessId            String                    @map("business_id") @db.Uuid
  business              Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  uploadId              String?                   @map("upload_id") @db.Uuid
  certificationId       String?                   @map("certification_id") @db.Uuid
  templateId            String?                   @map("template_id") @db.Uuid

  certificationSummary  Json?                     @map("certification_summary")
  aiRecommendations     Json?                     @map("ai_recommendations")
  templateVersion       Json?                     @map("template_version")

  overallScore          Float                     @default(0) @map("overall_score")
  status                ValidationReportStatus    @default(COMPLETED)

  sections              CmsValidationReportSection[]

  generatedBy           String                    @map("generated_by") @db.Uuid
  sourceType            String                    @default("CERTIFICATION") @map("source_type") @db.VarChar(50)
  sourceLabel           String?                   @map("source_label") @db.VarChar(255)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([certificationId])
  @@index([templateId])
  @@index([uploadId])
  @@map("cms_validation_reports")
}

model CmsValidationReportSection {
  id              String                        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
