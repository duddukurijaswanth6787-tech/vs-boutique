// ========================================================
// AI ORCHESTRATOR & AI PLATFORM SYSTEM MODELS
// ========================================================

model AIKnowledgeBase {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  tags      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIContext {
  id            String           @id @default(uuid())
  sessionId     String
  activeAgentId String
  variables     Json
  conversations AIConversation[]
}

model AIConversation {
  id        String    @id @default(uuid())
  contextId String
  context   AIContext @relation(fields: [contextId], references: [id])
  role      String // 'system' | 'user' | 'assistant'
  content   String
  createdAt DateTime  @default(now())
}

model AIArtifact {
  id               String   @id @default(uuid())
  version          String // e.g. "v1.0.0"
  checksum         String // SHA256 of payload
  createdByAgent   String // Agent ID
  schemaVersion    String   @default("v1.0.0")
  parentArtifactId String?
  status           String // 'Draft' | 'Finalized'
  payload          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AITool {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  category     String // 'search' | 'code' | 'validator'
  inputSchema  Json
  outputSchema Json
  permissions  Json
  timeout      Int      @default(5000)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ApprovalRequest {
  id          String            @id @default(uuid())
  targetType  String // 'Blueprint' | 'Standards' | 'Template'
  targetId    String
  status      ApprovalStatus    @default(PENDING_REVIEW)
  requesterId String
  history     ApprovalHistory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ApprovalHistory {
  id         String          @id @default(uuid())
  requestId  String
  request    ApprovalRequest @relation(fields: [requestId], references: [id])
  decision   String // 'Approved' | 'Rejected'
  comments   String?
  reviewerId String
  createdAt  DateTime        @default(now())
}

model AICacheRecord {
  id          String   @id @default(uuid())
  cacheKey    String   @unique // MD5 of prompt + schema
  responseVal String
  ttl         Int
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
}

model AIAgent {
  id               String         @id @default(uuid())
  name             String
  description      String
  providerId       String
  model            String // e.g. "gemini-1.5-pro", "gpt-4o"
  systemPrompt     String
  temperature      Float          @default(0.2)
  maxTokens        Int            @default(2048)
  inputSchema      Json // Expected input structure
  outputSchema     Json // Target JSON schema
  enabled          Boolean        @default(true)
  executionOrder   Int // Sequence order: 1..12
  retryPolicy      Json // { maxRetries: 3, backoffMs: 1000 }
  timeout          Int            @default(30000) // ms
  promptTemplateId String
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model PromptTemplate {
  id             String          @id @default(uuid())
  name           String
  activeVersion  String
  variables      Json // Array of variable tags
  promptsHistory PromptHistory[]
  agents         AIAgent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PromptHistory {
  id            String         @id @default(uuid())
  templateId    String
  template      PromptTemplate @relation(fields: [templateId], references: [id])
  version       String // e.g., "v1.2.0"
  promptContent String
  changeNotes   String
  author        String
  createdAt     DateTime       @default(now())
}

model AISession {
  id           String        @id @default(uuid())
  businessName String
  vertical     String
  status       SessionStatus @default(IN_PROGRESS)
  totalCost    Float         @default(0.0) // Aggregated USD
  totalTokens  Int           @default(0)
  executions   AIExecution[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AIExecution {
  id            String           @id @default(uuid())
  sessionId     String
  session       AISession        @relation(fields: [sessionId], references: [id])
  agentId       String
  status        ExecutionStatus  @default(PENDING)
  inputPayload  Json
  outputPayload Json?
  tokensUsed    Int              @default(0)
  latencyMs     Int              @default(0)
  retryCount    Int              @default(0)
  logs          AIExecutionLog[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model AIExecutionLog {
  id          String      @id @default(uuid())
  executionId String
  execution   AIExecution @relation(fields: [executionId], references: [id])
  level       LogLevel    @default(INFO)
  message     String
  timestamp   DateTime    @default(now())
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ExecutionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum ApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

// 1. Tenant Isolation
model Tenant {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(255)
  domain     String     @unique @db.VarChar(255)
  status     String     @default("ACTIVE") // ACTIVE, SUSPENDED
  businesses Business[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("tenants")
}

// 2. Global Business Entity
model Business {
  id                     String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId               String                  @map("tenant_id")
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String                  @db.VarChar(255)
  nicheVertical          String                  @map("niche_vertical") @db.VarChar(100)
  status                 String                  @default("ACTIVE")
  boutique               Boutique?
  websites               Website[]
  mobileApps             MobileApp[]
  plugins                BoutiquePlugin[]
  users                  UserRoleMapping[]
  releases               ImmutableRelease[]
  contentItems           UniversalContent[]
  assets                 AssetLibrary[]
  themes                 BoutiqueTheme[]
  certifications         BoutiqueCertification[]
  autofixQueue           AutoFixQueueItem[]
  certificationWorkflows CertificationWorkflow[]
  certificationProfiles  CertificationProfile[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  marketplaceInstallations MarketplaceInstallation[]
  marketplaceLicenses      MarketplaceLicense[]
  deploymentEnvironments   DeploymentEnvironment[]
  deployments              Deployment[]
  deploymentDomains        DeploymentDomain[]
  cmsUploads               CmsUpload[]
  validationReports        CmsValidationReport[]
  validationReportComparisons CmsValidationReportComparison[]
  validationReportAnalytics   CmsValidationReportAnalytics[]
  businessTemplateAssignments BusinessTemplateAssignment[]
  assignmentConfigurations    CmsAssignmentConfiguration[]
  developerApiKeys            DeveloperApiKey[]

  @@index([status])
  @@map("businesses")
}

// 3. Web & Mobile Entities
model Website {
  id         String         @id @default(uuid())
  businessId String         @map("business_id") @db.Uuid
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  domain     String?        @unique @db.VarChar(255)
  status     String         @default("DRAFT")
  pages      BoutiquePage[]
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@map("websites")
}

model MobileApp {
  id         String   @id @default(uuid())
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appName    String   @map("app_name") @db.VarChar(255)
  bundleId   String   @unique @map("bundle_id") @db.VarChar(255)
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("mobile_apps")
}

// 4. Universal Content System (Decoupled layout)
model UniversalContent {
  id           String               @id @default(uuid())
  businessId   String               @map("business_id") @db.Uuid
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key          String               @db.VarChar(100) // e.g. "hero-headline", "contact-phone"
  baseText     String               @db.Text
  translations ContentTranslation[]
  seoTags      Json? // { title, desc, keywords, ogImage }
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([businessId, key])
  @@map("universal_contents")
}

model ContentTranslation {
  id             String           @id @default(uuid())
  contentId      String           @map("content_id")
  content        UniversalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  locale         String           @db.VarChar(10) // e.g. "es", "fr", "hi"
  translatedText String           @db.Text
  translatedSeo  Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([contentId, locale])
  @@map("content_translations")
}

// 5. Central Asset Management Library
model AssetLibrary {
  id         String   @id @default(uuid())
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(255)
  type       String   @db.VarChar(50) // IMAGE, VIDEO, FONT, EMBROIDERY
  url        String   @db.VarChar(512)
  version    Int      @default(1)
  meta       Json // { sizeBytes, mimeType, compressionUrl, s3Bucket, cdnUrl }
  isAi       Boolean  @default(false) @map("is_ai")
  promptLog  String?  @map("prompt_log") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("asset_libraries")
}

// 6. Dynamic AI Agent Registry
model AIAgentRegistry {
  id              String         @id @default(uuid())
  name            String         @unique @db.VarChar(100)
  role            String         @db.VarChar(100)
  promptTemplate  String         @db.Text
  requiredInputs  Json // Array of parameter key tags
  producedOutputs Json // Target validation schemas
  dependencies    String[] // Dependent agent ids
  retryPolicy     Json // { maxAttempts, backoffMs }
  estimatedCost   Float          @default(0.0)
  estimatedTokens Int            @default(0)
  timeoutMs       Int            @default(30000)
  tasks           WorkflowTask[]
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("ai_agent_registry")
}

// 7. Workflow Engine
model WorkflowDefinition {
  id          String              @id @default(uuid())
  name        String              @unique @db.VarChar(100) // "Website Generation", "SEO Audit"
  description String?
  stages      WorkflowStage[]
  executions  WorkflowExecution[]
  createdAt   DateTime            @default(now()) @map("created_at")

  @@map("workflow_definitions")
}

model WorkflowStage {
  id         String             @id @default(uuid())
  workflowId String             @map("workflow_id")
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name       String             @db.VarChar(100)
  order      Int
  tasks      WorkflowTask[]
  createdAt  DateTime           @default(now()) @map("created_at")

  @@map("workflow_stages")
}

model WorkflowTask {
  id           String           @id @default(uuid())
  stageId      String           @map("stage_id")
  stage        WorkflowStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name         String           @db.VarChar(100)
  order        Int
  agentId      String?          @map("agent_id")
  agent        AIAgentRegistry? @relation(fields: [agentId], references: [id])
  artifactType String           @map("artifact_type") // e.g. "styling.json"
  dependencies String[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("workflow_tasks")
}

model WorkflowExecution {
  id         String             @id @default(uuid())
  workflowId String             @map("workflow_id")
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     String             @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  payload    Json // Input parameters
  progress   Float              @default(0.0)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("workflow_executions")
}

// 8. Reusable Themes
model BoutiqueTheme {
  id                 String   @id @default(uuid())
  businessId         String   @unique @map("business_id") @db.Uuid
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  colorsLight        Json
  colorsDark         Json
  typography         Json
  spacingScale       Json
  borderStyles       Json
  elevationShadows   Json
  animationScale     Json
  accessibilityTheme Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("boutique_themes")
}

// 9. Sitemap Pages
model BoutiquePage {
  id         String              @id @default(uuid())
  websiteId  String              @map("website_id")
  website    Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  title      String              @db.VarChar(255)
  slug       String              @db.VarChar(100)
  isEnabled  Boolean             @default(true) @map("is_enabled")
  status     String              @default("DRAFT")
  components PageComponentNode[]
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

