  status          String                        @default("PASSED") @db.VarChar(20)

  issues          Json                          @default("[]")
  suggestions     Json                          @default("[]")
  data            Json                          @default("{}")

  executionOrder  Int                           @default(0) @map("execution_order")
  createdAt       DateTime                      @default(now()) @map("created_at")

  @@unique([reportId, sectionType])
  @@map("cms_validation_report_sections")
}

