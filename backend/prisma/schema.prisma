model CmsPrompt {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title                String           @db.VarChar(500)
  description          String?          @db.Text
  promptType           String           @db.VarChar(100)
  categoryId           String?          @map("category_id") @db.Uuid
  category             CmsPromptCategory? @relation(fields: [categoryId], references: [id])
  builderId            String?          @map("builder_id") @db.Uuid
  builder              CmsAiBuilder?    @relation(fields: [builderId], references: [id])
  instructions         String?          @db.Text
  rules                String?          @db.Text
  outputFormat         String?          @db.Text
  expectedFiles        Json?
  expectedFolderStructure Json?
  codingStandards      String?          @db.Text
  framework            String?          @db.VarChar(255)
  libraries            Json?
  dependencies         Json?
  apiRequirements      String?          @db.Text
  dbRequirements       String?          @db.Text
  responsiveRules      String?          @db.Text
  performanceRules     String?          @db.Text
  securityRules        String?          @db.Text
  accessibilityRules   String?          @db.Text
  seoRules             String?          @db.Text
  testingRules         String?          @db.Text
  acceptanceCriteria   String?          @db.Text
  variables            Json?
  templateContent      String?          @db.Text
  version              Int              @default(1)
  isDeleted            Boolean          @default(false) @map("is_deleted")
  businessId           String?          @map("business_id") @db.Uuid
  referenceType        String?          @map("reference_type") @db.VarChar(50)
  referenceId          String?          @map("reference_id") @db.Uuid
  createdBy            String?          @map("created_by") @db.Uuid
  updatedBy            String?          @map("updated_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  versions             CmsPromptVersion[]
  tags                 CmsPromptTagPrompt[]
  favorites            CmsPromptFavorite[]
  history              CmsPromptHistory[]
  executions           CmsPromptExecution[]
  collectionItems      CmsPromptCollectionItem[]
  ratings              CmsPromptRating[]
  usageAnalytics       CmsPromptUsageAnalytics[]
  auditLogs            CmsPromptAuditLog[]

  @@index([businessId, isDeleted])
