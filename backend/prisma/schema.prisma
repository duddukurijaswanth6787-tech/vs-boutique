// 10. Page Component Nodes Tree
model PageComponentNode {
  id                 String       @id @default(uuid())
  pageId             String       @map("page_id")
  page               BoutiquePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentId           String?      @map("parent_id")
  name               String       @db.VarChar(100)
  type               String       @db.VarChar(100)
  variant            String       @default("default") @db.VarChar(50)
  order              Int
  styleTokens        Json
  editableProperties Json
  responsiveRules    Json
  animations         Json?
  visibilityRules    Json?
  permissions        Json?
  contentKeysBind    Json // Array of UniversalContent key pointers e.g. ["hero-headline"]
  dataSourceBind     String?      @map("data_source_bind") @db.VarChar(100)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("page_component_nodes")
}

// 11. Plugins Registry
model BoutiquePlugin {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id") @db.Uuid
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pluginKey   String   @map("plugin_key") @db.VarChar(100)
  isEnabled   Boolean  @default(false) @map("is_enabled")
  settings    Json
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([businessId, pluginKey])
  @@map("boutique_plugins")
}

// 12. User Role Mapping (RBAC)
model UserRoleMapping {
  id         String   @id @default(uuid())
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") // Reference to User id
  role       UserRole @default(GUEST)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([businessId, userId])
  @@map("user_role_mappings")
}

// 13. Immutable Releases
model ImmutableRelease {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id") @db.Uuid
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  releaseTag  String   @map("release_tag") @db.VarChar(50)
  status      String   @default("DRAFT") // DRAFT, QA, APPROVED, PUBLISHED, ARCHIVED
  environment String   @default("DEV")
  payloadDump Json // Complete config state
  checksum    String   @db.VarChar(64)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([businessId, releaseTag, environment])
  @@map("immutable_releases")
}

// 15. AI Learning Records
model AILearningRecord {
  id             String   @id @default(uuid())
  prompt         String   @db.Text
  blueprintId    String   @map("blueprint_id")
  stage          String
  generationTime Int      @map("generation_time_ms")
  errors         String[]
  userChanges    Json
  acceptanceRate Float    @map("acceptance_rate")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("ai_learning_records")
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  BUSINESS_OWNER
  MANAGER
  EMPLOYEE
  CUSTOMER
  GUEST
}

// 16. Workflow Definitions
model CertificationWorkflowDefinition {
  id             String                  @id @default(uuid())
  name           String                  @db.VarChar(100)
  description    String?                 @db.Text
  version        String                  @db.VarChar(50) // e.g. "v1.0.0", "v1.1.0"
  isEnabled      Boolean                 @default(true) @map("is_enabled")
  targetType     String                  @default("WEBSITE") @map("target_type") // WEBSITE, MOBILE_APP, LANDING_PAGE
  stages         Json // Array of stage specs: stageId, stageName, executionOrder, agentKey, retryPolicy, timeout, dependsOn, parallel, outputSchema
  rollbackPolicy Json                    @map("rollback_policy")
  workflows      CertificationWorkflow[]
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([name, version])
  @@map("certification_workflow_definitions")
}

// 17. Certification Workflows Trackers & Execution History
model CertificationWorkflow {
  id         String   @id @default(uuid())
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  releaseTag String   @map("release_tag") @db.VarChar(50)

  definitionId String                          @map("definition_id")
  definition   CertificationWorkflowDefinition @relation(fields: [definitionId], references: [id])

  status       String @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  progress     Float  @default(0.0)
  currentStage String @default("INITIALIZING") @map("current_stage")

  // Execution Telemetry History array: stageId, startedAt, finishedAt, duration, retryCount, status, logs, tokens, model, cost, outputChecksum
  executionHistory Json @map("execution_history")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("certification_workflows")
}

// 18. Dynamic QA Agent Registry
model QAAgentRegistry {
  id             String   @id @default(uuid())
  agentKey       String   @unique @map("agent_key") @db.VarChar(100) // e.g. "seo_crawler", "wcag_accessibility"
  name           String   @db.VarChar(150)
  category       String   @db.VarChar(100) // PERFORMANCE, SEO, ACCESSIBILITY, SECURITY, BRAND, UX
  executionOrder Int      @map("execution_order")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  version        String   @db.VarChar(50)
  timeoutMs      Int      @default(10000) @map("timeout_ms")
  configuration  Json // Custom configuration options (parameters, thresholds)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("qa_agent_registries")
}

// 19. Certification Profiles & Weighted Scoring Rules
model CertificationProfile {
  id             String                  @id @default(uuid())
  businessId     String?                 @map("business_id") @db.Uuid // Nullable for global platform templates
  business       Business?               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String                  @db.VarChar(100) // e.g. "Ecommerce", "Standard", "Enterprise"
  isActive       Boolean                 @default(false) @map("is_active")
  agentWeights   Json // Key-value weights map: { "seo_crawler": 0.3, "wcag_accessibility": 0.2 }
  thresholds     Json // Key-value criteria: { "minSeoScore": 80.0, "minOverall": 75.0 }
  certifications BoutiqueCertification[]
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([businessId, name])
  @@map("certification_profiles")
}

// 20. Boutique Certification Reports
model BoutiqueCertification {
  id         String   @id @default(uuid())
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  targetType String   @default("WEBSITE") // WEBSITE, MOBILE_APP, LANDING_PAGE, TEMPLATE, COMPONENT
  targetId   String   @map("target_id")
  releaseTag String   @map("release_tag") @db.VarChar(50)

  profileId String               @map("profile_id")
  profile   CertificationProfile @relation(fields: [profileId], references: [id])

  overallScore Float @map("overall_score")
  scoresMap    Json // Dynamic mapped scores per agent: { "seo_crawler": 95.0, "performance_agent": 87.0 }
  agentRuns    Json // Detailed agent metrics: executionTime, tokens, model, cost, warnings, errors, scoreContribution

  issues          Json // List of issues with Auto-Fix Safety Levels
  suggestions     Json // Optimization recommendations
  visualArtifacts Json // Headless review screenshots

  status    CertificationStatus @default(DRAFT)
  createdAt DateTime            @default(now()) @map("created_at")

  @@unique([businessId, targetId, releaseTag])
  @@map("boutique_certifications")
}

// 21. Auto-Fix Queue Mappings
model AutoFixQueueItem {
  id             String      @id @default(uuid())
  businessId     String      @map("business_id") @db.Uuid
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  releaseTag     String      @map("release_tag") @db.VarChar(50)
  issueKey       String      @map("issue_key") @db.VarChar(100)
  safetyLevel    SafetyLevel @default(SUGGESTED)
  description    String      @db.Text
  proposedChange Json // Target database records and fields modifications
  status         QueueStatus @default(PENDING) // PENDING, APPROVED, REJECTED, APPLIED
  reviewedBy     String?     @map("reviewed_by")
  reviewedAt     DateTime?   @map("reviewed_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("autofix_queue_items")
}

// 22. Chatbot QA Conversation threads
model CertificationChat {
  id              String   @id @default(uuid())
  certificationId String   @map("certification_id")
  role            String   @default("user") // user, assistant
  message         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("certification_chat_messages")
}

enum CertificationStatus {
  DRAFT
  REVIEWING
  NEEDS_FIXES
  APPROVED
  CERTIFIED
  PUBLISHED
}

enum SafetyLevel {
  SAFE_AUTO_FIX
  SUGGESTED
  MANUAL_APPROVAL_REQUIRED
}

enum QueueStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

// ==================================================
// PHASE 8B: ENTERPRISE MARKETPLACE SCHEMAS
// ==================================================

enum MarketplacePackageStatus {
  DRAFT
  IN_MODERATION
  APPROVED
  REJECTED
}

enum MarketplaceLicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PublisherRole {
  DEVELOPER
  ADMIN
}

model MarketplacePublisher {
  id         String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId    String               @map("owner_id") @db.Uuid
  owner      Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String               @db.VarChar(255)
  email      String               @unique @db.VarChar(255)
  website    String?              @db.VarChar(255)
  role       PublisherRole        @default(DEVELOPER)
  isVerified Boolean              @default(false) @map("is_verified")
  packages   MarketplacePackage[]
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@map("marketplace_publishers")
}

model MarketplacePackage {
  id            String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  publisherId   String                    @map("publisher_id") @db.Uuid
  publisher     MarketplacePublisher      @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  name          String                    @db.VarChar(255)
  slug          String                    @unique @db.VarChar(150)
  description   String                    @db.Text
  status        MarketplacePackageStatus  @default(DRAFT)
  ratingsAvg    Float                     @default(0.0) @map("ratings_avg")
  reviewsCount  Int                       @default(0) @map("reviews_count")
  downloads     Int                       @default(0)
  versions      MarketplaceVersion[]
  installations MarketplaceInstallation[]
  licenses      MarketplaceLicense[]
  reviews       MarketplaceReview[]
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("marketplace_packages")
}

model MarketplaceVersion {
  id            String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  packageId     String                    @map("package_id") @db.Uuid
  package       MarketplacePackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  version       String                    @db.VarChar(50) // SemVer
  manifestJson  Json                      @map("manifest_json")
  downloadUrl   String                    @map("download_url") @db.VarChar(512)
  checksum      String                    @db.VarChar(256)
  capabilities  MarketplaceCapability[]
  dependencies  MarketplaceDependency[]
  installations MarketplaceInstallation[]
  createdAt     DateTime                  @default(now()) @map("created_at")

  @@unique([packageId, version])
  @@map("marketplace_versions")
