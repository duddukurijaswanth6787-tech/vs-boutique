model CmsTemplate {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String   @db.VarChar(500)
  description     String?  @db.Text
  industry        String?  @db.VarChar(100)
  status          String   @default("DRAFT") @db.VarChar(50)
  tier            String   @default("FREE") @db.VarChar(50)
  version         Int      @default(1)
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  isDeleted       Boolean  @default(false) @map("is_deleted")

  // Preview assets
  thumbnail       String?  @db.Text
  previewImage    String?  @map("preview_image") @db.Text
  previewVideo    String?  @map("preview_video") @db.Text
  liveDemoUrl     String?  @map("live_demo_url") @db.Text
  zipArtifact     String?  @map("zip_artifact") @db.Text
  manifestUrl     String?  @map("manifest_url") @db.Text

  // Template Manifest from Blueprint Engine
  manifest        Json?

  // Pipeline source links
  promptId        String?  @map("prompt_id") @db.Uuid
  blueprintId     String?  @map("blueprint_id") @db.Uuid
  certificationId String?  @map("certification_id") @db.Uuid

  categoryId      String?  @map("category_id") @db.Uuid
  category        CmsTemplateCategory? @relation(fields: [categoryId], references: [id])
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  versions         CmsTemplateVersion[]
  tags             CmsTemplateTagTemplate[]
  favorites        CmsTemplateFavorite[]
  ratings          CmsTemplateRating[]
  analytics        CmsTemplateAnalytics[]
  pipelineStages   CmsTemplatePipelineStage[]
  builderCompat    CmsTemplateBuilderCompatibility[]
  assignments      BusinessTemplateAssignment[]

  @@index([status, isDeleted])
  @@index([tier, isDeleted])
  @@index([categoryId])
  @@index([createdAt])
  @@map("cms_templates")
}

