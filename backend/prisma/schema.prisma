  failCount         Int      @default(0) @map("fail_count")

  sectionAverages   Json     @default("{}") @map("section_averages")
  scoreDistribution Json     @default("{}") @map("score_distribution")

  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([businessId, periodStart, periodEnd])
  @@map("cms_validation_report_analytics")
}

model CmsValidationReportHistory {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reportId        String   @map("report_id") @db.Uuid
  action          String   @db.VarChar(50)
  previousStatus  String?  @map("previous_status") @db.VarChar(20)
  newStatus       String?  @map("new_status") @db.VarChar(20)
  changes         Json     @default("{}")
  performedBy     String   @map("performed_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@map("cms_validation_report_history")
}

// ===== PHASE 14: AI AGENT CENTER =====

model CmsAiProvider {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @db.VarChar(255)
  key         String   @unique @db.VarChar(100)
  provider    String   @db.VarChar(50) // gemini, openai, claude, deepseek, grok, openrouter, bolt, lovable, v0, firebase
  model       String   @default("gemini-1.5-pro") @db.VarChar(255)
  baseUrl     String?  @map("base_url") @db.VarChar(512)
  apiKey      String   @map("api_key") @db.Text // encrypted
  temperature Float    @default(0.7)
  maxTokens   Int      @default(4096) @map("max_tokens")
  supportsStreaming Boolean @default(true) @map("supports_streaming")
  supportsThinking   Boolean @default(false) @map("supports_thinking")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  priority    Int      @default(0) // lower = higher priority
  costPerMillionTokens Json @default("{}") @map("cost_per_million_tokens")
  rateLimit   Json     @default("{}") @map("rate_limit")
  retryPolicy Json     @default("{\"maxRetries\":3,\"backoffMs\":1000}") @map("retry_policy")
  timeout     Int      @default(30000)
  lastHealthCheck  DateTime? @map("last_health_check")
  healthStatus     String   @default("unknown") @db.VarChar(20) @map("health_status") // healthy, degraded, offline, unknown
  healthMessage    String?  @map("health_message") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  agents CmsAiAgent[]
  usage  CmsAiUsage[]
  costs  CmsAiCost[]

  @@index([provider])
  @@index([isEnabled])
  @@index([priority])
  @@map("cms_ai_providers")
}

model CmsAiAgent {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @db.VarChar(255)
  key         String   @unique @db.VarChar(100)
  description String?  @db.Text
  category    String   @db.VarChar(50) // pipeline, certification, prompt, aifix, workflow, custom
  source      String   @db.VarChar(50) // ai-core, certification, custom
  sourceId    String?  @map("source_id") @db.VarChar(255)
  providerId  String?  @map("provider_id") @db.Uuid
  provider    CmsAiProvider? @relation(fields: [providerId], references: [id])
  model       String?  @db.VarChar(255)
  systemPrompt String? @map("system_prompt") @db.Text
  isEnabled   Boolean  @default(true) @map("is_enabled")
  executionOrder Int   @default(0) @map("execution_order")
  dependencies String[] @default([])
  timeout     Int      @default(30000)
  retryPolicy Json     @default("{}") @map("retry_policy")
  version     String   @default("1.0.0") @db.VarChar(20)
  healthStatus String  @default("unknown") @db.VarChar(20) @map("health_status")
  metrics     Json     @default("{}")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isEnabled])
  @@index([source])
  @@map("cms_ai_agents")
}

model CmsAiWorkflow {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  stages      Json     @default("[]") // Array of {name, agentKey, order, config}
  status      String   @default("active") @db.VarChar(20) // active, inactive, draft
  trigger     String   @default("manual") @db.VarChar(20) // manual, scheduled, event
  schedule    String?  @db.VarChar(100) // cron expression
  eventTrigger String? @map("event_trigger") @db.VarChar(100) // event name if trigger=event
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("cms_ai_workflows")
}

model CmsAiExecutionStep {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  executionId   String    @map("execution_id") @db.Uuid
  agentKey      String    @map("agent_key") @db.VarChar(100)
  agentName     String    @map("agent_name") @db.VarChar(255)
  status        String    @default("PENDING") @db.VarChar(20)
  inputPayload  Json?     @map("input_payload")
  outputPayload Json?     @map("output_payload")
  tokensUsed    Int       @default(0) @map("tokens_used")
  latencyMs     Int       @default(0) @map("latency_ms")
  retryCount    Int       @default(0) @map("retry_count")
  errorMessage  String?   @map("error_message") @db.Text
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([executionId])
  @@index([status])
  @@map("cms_ai_execution_steps")
}

model CmsAiUsage {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  providerId      String?  @map("provider_id") @db.Uuid
  provider        CmsAiProvider? @relation(fields: [providerId], references: [id])
  agentKey        String?  @map("agent_key") @db.VarChar(100)
  executionId     String?  @map("execution_id") @db.Uuid
  model           String   @db.VarChar(255)
  promptTokens    Int      @default(0) @map("prompt_tokens")
  completionTokens Int     @default(0) @map("completion_tokens")
  totalTokens     Int      @default(0) @map("total_tokens")
  cost            Float    @default(0.0)
  date            DateTime @default(now())
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([providerId])
  @@index([date])
  @@index([agentKey])
  @@map("cms_ai_usage")
}

model CmsAiCost {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  providerId  String?  @map("provider_id") @db.Uuid
  provider    CmsAiProvider? @relation(fields: [providerId], references: [id])
  agentKey    String?  @map("agent_key") @db.VarChar(100)
  executionId String?  @map("execution_id") @db.Uuid
  cost        Float    @default(0.0)
  currency    String   @default("USD") @db.VarChar(3)
  description String?  @db.Text
  category    String   @default("execution") @db.VarChar(50) // execution, provider, agent, workflow
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([providerId])
  @@index([createdAt])
  @@index([category])
  @@map("cms_ai_costs")
}

model CmsAiSettings {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key         String     @unique @db.VarChar(100)
  value       Json
  category    String     @default("general") @db.VarChar(50)
  description String?    @db.Text
  updatedAt   DateTime   @updatedAt @map("updated_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([category])
  @@map("cms_ai_settings")
}

model DeveloperApiKey {
  id                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String   @db.VarChar(255)
  key                  String   @unique @db.VarChar(128)
  prefix               String   @db.VarChar(20)
  scopes               Json     @default("[]")
  status               String   @default("ACTIVE") @db.VarChar(20)
  environment          String   @default("PRODUCTION") @db.VarChar(20)
  createdBy            String?  @map("created_by") @db.Uuid
  expiresAt            DateTime? @map("expires_at")
  lastUsedAt           DateTime? @map("last_used_at")
  rotatedAt            DateTime? @map("rotated_at")
  revokedAt            DateTime? @map("revoked_at")
  usageCount           Int      @default(0) @map("usage_count")
  lastIpAddress        String?  @map("last_ip_address") @db.VarChar(45)
  allowedIps           Json     @default("[]")
  rateLimitOverride    Int?     @map("rate_limit_override")
  webhookSigningSecret String?  @map("webhook_signing_secret") @db.VarChar(128)
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([key])
  @@index([status])
  @@map("developer_api_keys")
}
