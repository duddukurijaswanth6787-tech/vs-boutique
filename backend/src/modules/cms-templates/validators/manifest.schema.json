{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template Manifest",
  "description": "Blueprint Engine manifest for certified website templates",
  "type": "object",
  "required": ["pages", "components", "apis", "databaseModels"],
  "properties": {
    "pages": {
      "type": "array",
      "description": "List of page routes in the template",
      "items": { "type": "string" },
      "minItems": 1
    },
    "components": {
      "type": "array",
      "description": "Reusable UI components",
      "items": { "type": "string" },
      "minItems": 1
    },
    "apis": {
      "type": "array",
      "description": "API endpoints",
      "items": { "type": "string" }
    },
    "databaseModels": {
      "type": "array",
      "description": "Database models/collections",
      "items": { "type": "string" }
    },
    "features": {
      "type": "array",
      "description": "Template features",
      "items": { "type": "string" }
    },
    "environmentVariables": {
      "type": "array",
      "description": "Required environment variables",
      "items": { "type": "string" }
    },
    "seoRules": {
      "type": "string",
      "description": "SEO configuration rules"
    },
    "securityRules": {
      "type": "string",
      "description": "Security hardening rules"
    },
    "dependencies": {
      "type": "array",
      "description": "Package dependencies",
      "items": { "type": "string" }
    },
    "sdkVersion": {
      "type": "string",
      "description": "Target SDK version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedArtifacts": {
      "type": "array",
      "description": "Generated file paths",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
