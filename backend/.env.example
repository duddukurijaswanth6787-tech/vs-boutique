# VS Boutique Backend - Production Environment Variables Example

# Server Config
PORT=3005
NODE_ENV=production
APP_VERSION=1.0.0
CORS_ORIGIN=https://vsboutique.shop,https://www.vsboutique.shop,https://admin.vsboutique.shop,https://owner.vsboutique.shop
RATE_LIMIT_MAX=1000

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@host:port/database_name?schema=public"

# Auth
JWT_SECRET="your_production_jwt_signing_secret_key"

# Default Super Admin Setup
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="production_secure_password"
SUPER_ADMIN_EMAIL="admin@vsboutique.com"

# Razorpay Config (Production/Live Keys)
RAZORPAY_KEY_ID="rzp_live_your_live_key_id"
RAZORPAY_KEY_SECRET="your_live_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_live_webhook_secret"

# AWS S3 Storage Config
AWS_ACCESS_KEY="your_aws_access_key_id"
AWS_SECRET_KEY="your_aws_secret_access_key"
AWS_REGION="ap-southeast-2"
AWS_BUCKET_NAME="vs-boutique-web-images"
